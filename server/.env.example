# ========================================
# REQUIRED
# ========================================

# PostgreSQL connection string (e.g. Supabase, Railway, local)
DATABASE_URL=postgresql://user:password@localhost:5432/riven

# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-random-secret-key-here

# ========================================
# OPTIONAL (defaults shown)
# ========================================

# Google Gemini API Key for AI Flashcards
GEMINI_API_KEY=your-gemini-api-key-here

# Edlink Application API Keys for Universal LMS Syncing
EDLINK_CLIENT_ID=your-edlink-client-id-here
EDLINK_SECRET=your-edlink-secret-here

# Your frontend URL (used for Edlink OAuth redirect after login)
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
PORT=3000

# Sentry (API errors, 5xx via next(err), console.error in catch blocks, unhandled rejections)
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=  # match client VITE_SENTRY_RELEASE / git SHA when possible
# SENTRY_TRACES_SAMPLE_RATE=0.1

# CORS - comma-separated list of allowed origins (REQUIRED for login when frontend/API on different domains)
# Must include your frontend URL so cookies work
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Production (frontend on Vercel, API on Railway, etc.):
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-domain.com

# Supabase (for Storage file cleanup on delete)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: used by the legacy Google compatibility bridge if it receives
# an ID token instead of a provider access token.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: used by the legacy Apple compatibility bridge for users who still
# need the Express /api/auth/oauth/apple fallback (for example legacy 2FA users).
# This should match the Apple client ID configured for native sign-in in Supabase.
# APPLE_CLIENT_ID=com.riven.app
# APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
# APPLE_KEY_ID=YOUR_APPLE_KEY_ID
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Cloudflare Turnstile CAPTCHA (signup bot protection)
# If not set, CAPTCHA verification is skipped (useful for local dev)
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
#
# Capacitor native signup: the in-app WebView often cannot load Turnstile. The client omits the widget on
# native and sends X-Riven-Client: capacitor on legacy POST /api/auth/register.
# Non-production (NODE_ENV !== production): skip is allowed by default unless you set
# ALLOW_CAPACITOR_REGISTER_SKIP_TURNSTILE=0 or false. Production: set to 1/true to allow (header is
# forgeable — pair with rate limits / your threat model).
# ALLOW_CAPACITOR_REGISTER_SKIP_TURNSTILE=1
