# ========================================
# REQUIRED
# ========================================

# PostgreSQL connection string (e.g. Supabase, Railway, local)
DATABASE_URL=postgresql://user:password@localhost:5432/riven

# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-random-secret-key-here

# ========================================
# OPTIONAL (defaults shown)
# ========================================

NODE_ENV=development
PORT=3000

# CORS - comma-separated list of allowed origins
# In production, set to your actual frontend URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# For production example:
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-domain.com
