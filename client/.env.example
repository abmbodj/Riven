# API URL - REQUIRED when deployed online (frontend and API on different domains)
# Leave unset for local dev (uses /api via Vite proxy)
# Production:
# VITE_API_URL=https://your-api.railway.app/api
#
# Supabase Edge Functions (set in dashboard / CLI, not here): CLIENT_URL=https://your-web-app
# — used for Stripe checkout/portal return URLs when the app Origin is capacitor:// (iOS/Android).

# Supabase - REQUIRED for auth, storage, and real-time features
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth for web/PWA is configured in Supabase Auth.
# Google Cloud OAuth must authorize the Supabase callback (replace with your project URL):
# https://<project-ref>.supabase.co/auth/v1/callback
# Supabase Auth must separately allow your app return URLs (for example /account on prod and localhost).
#
# Capacitor iOS native Google Sign-In (same Web client as Supabase Google provider):
# - Google Cloud: create an iOS OAuth client for bundle ID com.riven.app; copy iOS client ID and reversed
#   client ID (URL scheme) into ios/debug.xcconfig as GOOGLE_IOS_CLIENT_ID and GOOGLE_IOS_URL_SCHEME.
# - Set VITE_GOOGLE_WEB_CLIENT_ID to the Web application OAuth client ID (must match Supabase Auth → Google → Client ID).
VITE_GOOGLE_WEB_CLIENT_ID=

# Capacitor iOS native Sign in with Apple:
# - No client-side env var is required.
# - Configure the Apple provider in the hosted Supabase dashboard.
# - Enable Sign in with Apple for bundle ID com.riven.app in Apple Developer.

# Cloudflare Turnstile CAPTCHA (signup bot protection)
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
#
# Capacitor / iOS / Android: the signup screen does not embed Turnstile in the native shell (WKWebView
# often cannot host the widget). Web and PWA builds still use Turnstile when VITE_TURNSTILE_SITE_KEY is set.
# For legacy API register with TURNSTILE_SECRET_KEY, set ALLOW_CAPACITOR_REGISTER_SKIP_TURNSTILE on the server
# (see server/.env.example) or rely on the Supabase + complete-registration path when email confirm is off.
#
# Local dev only — skip widget (do not ship): also unset TURNSTILE_SECRET_KEY on the API or signup will fail.
# VITE_SKIP_TURNSTILE=1

# Sentry (browser / PWA / Capacitor WebView JS errors) — production only; omit for local dev
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=riven-web@1.0.0  # align with SENTRY_RELEASE on Vercel for source maps
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
#
# Vercel / CI: source map upload (not bundled into the client; used at build time only)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_RELEASE=  # e.g. $VERCEL_GIT_COMMIT_SHA

# Stripe Price IDs (required for payments)
# VITE_STRIPE_PRICE_MONTHLY=price_xxx
# VITE_STRIPE_PRICE_ANNUAL=price_xxx
# (legacy) VITE_STRIPE_PRICE_LIFETIME is still read as a fallback for the annual slot if ANNUAL is unset

# RevenueCat — iOS native only (Capacitor). Web / PWA keeps Stripe.
# Get this from RevenueCat dashboard → Project → Apps → iOS → Public API Key (appl_xxxxx)
# Also set RC_WEBHOOK_SECRET in server/.env for the server-to-server webhook.
# VITE_RC_IOS_API_KEY=appl_xxxxx

# PostHog (product analytics) — omit both for local dev if unused
# VITE_PUBLIC_POSTHOG_KEY=phc_xxx
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # EU: https://eu.i.posthog.com

# Streak garden rebuild ("luminous depth") — opt-in feature flags (on = 'true' or '1')
# Phase 1: swap the rebuilt hero-tree GardenScene in for the legacy art
# VITE_NEW_GARDEN=1
# Phase 2: milestone transformation cinematic
# VITE_GARDEN_CINEMATIC=1
# Phase 3: gallery LOD wiring + share/export image
# VITE_GARDEN_SHARE=1
