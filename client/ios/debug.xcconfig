CAPACITOR_DEBUG = true

// Google Sign-In (native iOS): iOS OAuth client in Google Cloud for bundle ID com.riven.app.
// GOOGLE_IOS_CLIENT_ID = iOS client ID (*.apps.googleusercontent.com).
// GOOGLE_IOS_URL_SCHEME = reversed client ID (e.g. com.googleusercontent.apps.123456789-abc).
GOOGLE_IOS_CLIENT_ID = YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.YOUR_REVERSED_CLIENT_ID
