{
  "name": "riven-root",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "prepare": "husky",
    "eval": "deno run -A --node-modules-dir=auto eval/run.ts",
    "eval:retrieval": "deno run -A --node-modules-dir=auto eval/run.ts --retrieval-only --min-recall5 0.95 --out eval/results/ci.json",
    "test:rag": "deno test -A --node-modules-dir=auto supabase/tests/rag/",
    "rag:backfill": "deno run -A --node-modules-dir=auto scripts/rag-backfill.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "knip": "6.3.1"
  }
}
